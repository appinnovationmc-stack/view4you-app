# ── Web / mobile app (public values, safe to ship in the bundle) ─────────────────────────────
# Supabase dashboard → Project Settings → API. Use the anon/publishable key ONLY, never service_role.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Edge Function secrets (set with `supabase secrets set`, NEVER in .env or the app) ───────
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=true                    # true for sandbox.payfast.co.za, false/unset for live
# PAYFAST_RETURN_URL=https://your-app-domain/?pf=return
# PAYFAST_CANCEL_URL=https://your-app-domain/?pf=cancel
# PAYFAST_NOTIFY_URL=https://<project-ref>.supabase.co/functions/v1/payfast-itn
# PAYFAST_ENFORCE_IP=true                 # leave on; see docs/RELEASE_CHECKLIST.md
# PAYFAST_ALLOWED_IPS=                    # optional comma-separated override of the source IP allowlist
